# 虚拟环境
venv/
.env

# 数据目录整体不入库（向量库、crm.db 含真实用户手机号与密码哈希，绝不能公开）。
# 但评估结果是作品的一部分，用 data/* + ! 精确放行报告 csv
# （写成 data/ 会导致整个目录被排除，git 无法在被排除的目录里重新包含文件）：
data/*
# !data/ragas_report_*.csv
logs/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 操作系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log

# 临时文件
*.tmp
*.bak

# 测试 / 覆盖率产物
.pytest_cache/
.coverage
coverage.xml
htmlcov/

*.whl