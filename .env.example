# AI_CRM 环境变量模板——复制为 .env 后填自己的值；.env 已被 .gitignore 忽略，绝不可提交。
# 注意：跑 pytest 不需要本文件（缺变量时 config.py 有兜底默认值，测试不触碰外部服务）。

# 百炼 / OpenAI 兼容端点的密钥。两处填同一个值：
# 业务代码（intent.py、response_generator.py、function_calling_handler.py、app.py）读 OPENAI_API_KEY，
# config.py 另外暴露的 DASHSCOPE_API_KEY 目前无人使用，为兼容保留。
DASHSCOPE_API_KEY =
OPENAI_API_KEY =

# 百炼的 OpenAI 兼容 base_url 与模型名
OPENAI_BASE_URL =
MODEL_NAME =

# 博查联网搜索（可选，留空则相关分支自动跳过）
BOCHA_API_KEY =

# JWT 签名密钥。生成：
#   python -c "import secrets;print(secrets.token_hex(32))"
# 换掉它会让所有已登录会话失效（用户需重新登录），这是预期行为。
JWT_SECRET =

# 中文嵌入模型：路径或 HuggingFace 模型名。
# 本地部署指向已下载的 bge-base-zh-v1.5；容器内由 docker-compose.yml 的 environment 覆盖成 /app/chinese_model/...
EMBEDDING_MODEL = BAAI/bge-base-zh-v1.5
