# AI_CRM 环境变量模板——复制为 .env 后填自己的值；.env 已被 .gitignore 忽略，绝不可提交。
# 注意：跑 pytest 不需要本文件（缺变量时 config.py 有兜底默认值，测试不触碰外部服务）。

# 百炼 / OpenAI 兼容端点的密钥。两处填同一个值：
# 业务代码（intent.py、response_generator.py、function_calling_handler.py、app.py）读 OPENAI_API_KEY，
# config.py 另外暴露的 DASHSCOPE_API_KEY 目前无人使用，为兼容保留。
DASHSCOPE_API_KEY =
OPENAI_API_KEY =

# 百炼的 OpenAI 兼容 base_url 与模型名
OPENAI_BASE_URL =
MODEL_NAME =

# 博查联网搜索（可选，留空则相关分支自动跳过）
BOCHA_API_KEY =

# JWT 签名密钥。生成：
#   python -c "import secrets;print(secrets.token_hex(32))"
# 换掉它会让所有已登录会话失效（用户需重新登录），这是预期行为。
JWT_SECRET =

# 中文嵌入模型：路径或 HuggingFace 模型名。
# 本地部署指向已下载的 bge-base-zh-v1.5；容器内由 docker-compose.yml 的 environment 覆盖成 /app/chinese_model/...
EMBEDDING_MODEL = BAAI/bge-base-zh-v1.5

# ---- Langfuse 自托管（docker-compose.langfuse.yml）----
# 下面这组键必须写成 KEY=value（等号两边不留空格）：docker compose 的 dotenv 解析器
# 不像 config.py 那样会 strip 键名，带空格会被当成另一个键。
# 随机值生成方式：openssl rand -hex 32（或 python -c "import secrets;print(secrets.token_hex(32))"）
# ENCRYPTION_KEY 必须是 64 个十六进制字符（= 32 字节），长度不对 Langfuse 启动即失败。
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
# MinIO 的 access key（S3 用户名，≥3 字符）与 secret key（≥8 字符）
LANGFUSE_MINIO_USER=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# 应用侧上报地址：AI_CRM 跑在容器里，所以用 host.docker.internal 而不是 localhost
LANGFUSE_HOST=http://host.docker.internal:3030
# 在 Langfuse UI 里建好 project 后，把它的 API key 粘到这两行
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
